# ============ 绝对不要上传的文件 ============
# 设备专属解锁镜像（泄露 = 别人能解锁你的机器）
sn.img
sn-*.img
sn_test.img

# 设备标识（序列号 / Bootloader_SN）
*serial*
*bootload_sn*
device_info.txt
my_device.md

# 分区备份（体积大且含设备私有数据）
stock_backup/
stock_backup_b/
*.img
!docs/images/*.png

# 固件与工具二进制
fw_extract/
mtkclient/
*.7z
*.zip
*.rar
*.apk
ghostlock-extract.exe

# 日志（可能含设备信息）
*.log
logs/

# 系统
.DS_Store
Thumbs.db
